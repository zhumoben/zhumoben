{
  "name": "zhumoben",
  "version": "0.1.0",
  "description": "Local-first interview question bank and scorecard.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/zhumoben/zhumoben",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zhumoben/zhumoben.git"
  },
  "keywords": [
    "interview",
    "scorecard",
    "question-bank",
    "local-first",
    "mdx"
  ],
  "bin": {
    "zhumoben": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema.js"
  },
  "files": [
    "dist",
    "app",
    "shared",
    "templates",
    "README.md",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "html-to-image": "^1.11.13",
    "jiti": "^2.4.2",
    "react": "^19.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.1",
    "react-feather": "^2.0.10",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
